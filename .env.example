# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 .gitignore 에 있어 저장소에 올라가지 않아요)

# Postgres 비밀번호 (Docker). 접속 주소에 들어가므로 영문·숫자만 쓰는 걸 권장해요
DB_PASSWORD=

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
# 브라우저가 접속하는 주소 (CORS)
PUBLIC_ORIGIN=http://localhost:3001

# 인증번호 메일을 보낼 Gmail 계정
MAIL_USERNAME=SMTP-enabled-email
# Google 계정 비밀번호가 아니라 '앱 비밀번호' 16자리 (Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호)
# 두 값을 모두 비워 두면 메일 대신 API 로그에 인증번호가 찍혀요 (로컬 개발용)
MAIL_PASSWORD=gmail-app-password

# 소셜 로그인 (비워 두면 그 버튼은 "준비 중" 안내만 떠요)
# 사이트 바깥 주소 (끝에 / 없이). 소셜 로그인 Redirect URI 와 로그인 뒤 돌아갈 주소를 모두 이 값으로 만들어요
# 배포: https://habitloop-eight.vercel.app · 로컬 개발: http://localhost:3001
# 각 개발자 콘솔에 등록할 Redirect URI: {SITE_URL}/api/auth/oauth/{google|kakao|naver}/callback
SITE_URL=
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID (웹 애플리케이션). 이메일 · 이름 · 사진 (생일은 받지 않음)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Kakao Developers → 내 애플리케이션 → 앱 키의 REST API 키 · 카카오 로그인 → 보안의 Client Secret(켰다면)
# 동의 항목: 카카오계정(이메일) 필수 · 닉네임 · 프로필 사진 선택 (생일 · 출생 연도는 사업자 등록이 필요해 받지 않음)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# NAVER Developers → 애플리케이션 등록 (네이버 로그인) 제공 정보: 이메일 필수 · 별명 · 프로필 사진 · 생일 · 출생연도 추가
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 카카오톡 공유: 카카오 개발자 콘솔 → 내 애플리케이션 → 앱 키의 'JavaScript 키' (서버가 웹에 넘겨줘요)
# JavaScript SDK 도메인(또는 플랫폼 → Web)에 사이트 도메인을 등록해야 해요. 비워 두면 공유 창에서 카카오톡 버튼만 빠져요
KAKAO_JS_KEY=

# 관리자 페이지 (회원 계정과 따로, 회원가입 필요 없음). 셋 중 하나라도 비우면 관리자 기능이 꺼져요
# 사이트 주소/{ADMIN_KEY} 에서만 열려요. 영문 · 숫자 · - · _ 32자 이상 무작위 값
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_KEY=
# 관리자 로그인 이메일 (로그인할 때마다 이 주소로 인증번호가 가요)
ADMIN_EMAIL=
# 관리자 비밀번호 (12자 이상)
ADMIN_PASSWORD=
