{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "api",
      "framework": "nestjs",
      "entrypoint": "src/main.ts"
    },
    "web": {
      "root": "web",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon\\.svg|icon-192\\.png|icon-512\\.png|icon-maskable-512\\.png|apple-touch-icon\\.png|og-v2\\.png|manifest\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/.well-known/(assetlinks\\.json|apple-app-site-association)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/posts/:id(\\d+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(kakaotalk-scrap|Discordbot|Slackbot|Twitterbot|facebookexternalhit|TelegramBot|LinkedInBot|WhatsApp|Yeti|Googlebot|bingbot|Applebot|redditbot|Pinterestbot|Embedly|Iframely).*"
        }
      ],
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
