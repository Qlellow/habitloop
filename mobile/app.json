{
  "expo": {
    "name": "루프",
    "slug": "loop",
    "owner": "qlellow",
    "scheme": "loop",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.loop.community"
    },
    "android": {
      "package": "dev.loop.community",
      "adaptiveIcon": {
        "backgroundColor": "#3182F6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "글 · 채널 아이콘 · 프로필 사진에 넣을 사진을 고르려면 사진 접근 권한이 필요해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "updates": {
      "url": "https://u.expo.dev/d0aa314d-916f-4db5-9036-5fffd0a8e2d5"
    },
    "extra": {
      "eas": {
        "projectId": "d0aa314d-916f-4db5-9036-5fffd0a8e2d5"
      }
    }
  }
}
